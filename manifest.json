{
    "manifest_version": 3,
    "name": "Ani-extension",
    "description": "Ani-bankai extension, to track your anime and manga",
    "version": "0.0.1",
    "icons": {
        "16": "public/logo/logo-16.png",
        "48": "public/logo/logo-48.png",
        "128": "public/logo/logo-128.png"
    },
    "options_page": "src/components/settings/settings.html",
    "web_accessible_resources": [
        {
            "resources": [
                "login.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        },
        {
            "resources": [
                "assets/AnimeFilter.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "action": {
        "default_title": "Ani-extension",
        "default_popup": "src/components/popup/popup.html"
    },
    "permissions": [
        "tabs",
        "activeTab",
        "scripting",
        "storage",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": [
        "*://*/*",
        "https://api.opensubtitles.com/*"
    ],
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self';"
    },
    "content_scripts": [
        {
            "run_at": "document_idle",
            "js": [
                "src/streaming-website/features/subtitle-btn.js",
                "src/utils/videoUtils.js",
                "src/utils/anilistUtils.js",
                "src/utils/navigationUtils.js",
                "src/utils/utils.js",
                "src/streaming-website/netflix.js",
                "src/streaming-website/voiranime.js",
                "src/streaming-website/crunchyroll.js",
                "src/interfaces/Anime.js",
                "content-script.js"
            ],
            "matches": [
                "https://v6.voiranime.com/*",
                "https://*.crunchyroll.com/*",
                "https://vidmoly.net/*",
                "https://designparty.sx/*",
                "https://w9gw7oou.com/*",
                "*://*.voe.sx/*",
                "https://sandratableother.com/*",
                "https://my.mail.ru/*",
                "https://streamtape.com/*",
                "https://www.netflix.com/watch/*"
            ],
            "all_frames": true
        }
    ],
    "externally_connectable": {
        "matches": [
            "*://*/*"
        ]
    }
}